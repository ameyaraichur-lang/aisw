# Names only. Never commit real values; secrets come from the vault by reference.
AISW_ENV=dev
AISW_ASSESSMENT_MODE=read_only
AISW_ALLOW_PRODUCTION_REMEDIATION=false
AISW_REQUIRE_SCOPE_MANIFEST=true
AISW_REQUIRE_APPROVAL_FOR_ACTIVE_SCANS=true
AISW_DEV_AUTH_STUB=true
# Processes (ADR-029, deploy/README.md). Secrets go in files under AISW_SECRETS_DIR, named after
# the setting (aisw_database_url, aisw_session_secret, ...), never in env files.
# AISW_SECRETS_DIR=/run/secrets
# AISW_API_HOST=127.0.0.1
# AISW_API_PORT=8000
# AISW_API_TRUSTED_PROXIES=127.0.0.1
# AISW_WORKER_HEARTBEAT_FILE=/run/aisw/worker.heartbeat
# AISW_MIGRATION_DATABASE_URL_FILE=/run/secrets/aisw_migration_database_url   (bootstrap only)
# Policy engine (ADR-003, ADR-031). python = interim evaluator; opa = the packaged Rego on OPA.
# AISW_POLICY_ENGINE=opa
# AISW_OPA_URL=http://127.0.0.1:8181   (loopback or an internal service name over http; else https)
# Egress (ADR-028): scan zones the worker may reach, firewall ports, DNS, extra control-plane hosts.
# AISW_EGRESS_SCAN_CIDRS=10.20.0.0/16
# AISW_EGRESS_SCAN_PORTS=80,443
# AISW_EGRESS_DNS_SERVERS=10.0.0.2
# AISW_EGRESS_ALLOWED_HOSTS=
# Manifest signing custody (ADR-027). local_file is dev/test only; prod uses a Transit KMS.
# AISW_SIGNING_BACKEND=transit
# AISW_KMS_ADDR=https://kms.example.com:8200
# AISW_KMS_KEY=aisw-manifests
# AISW_KMS_TOKEN_FILE=/run/secrets/kms-app-token   (0600; read+sign only)
# AISW_SIGNING_REVOKED_KEY_IDS=
# OIDC sign-in through the BFF (ADR-026, docs/runbooks/sign-in.md). Unset issuer = SSO off.
# AISW_OIDC_ISSUER=https://idp.example.com/realms/security
# AISW_OIDC_CLIENT_ID=aisw-console
# AISW_OIDC_CLIENT_SECRET=   (from the secret provider; never commit)
# AISW_OIDC_REDIRECT_URI=https://console.example.com/api/v1/auth/callback
# AISW_SESSION_SECRET=       (>= 32 random characters, from the secret provider)
# AISW_OIDC_ROLE_MAP={"sec-admins":"project_admin"}
# AISW_OIDC_SESSION_MINUTES=480
AISW_AI_ENABLED=false
AISW_MODEL_TIMEOUT_SECONDS=60
AISW_EVIDENCE_RETENTION_DAYS=365
AISW_MAX_ASSESSMENT_CONCURRENCY=2
AISW_ENABLE_ITSM_TICKET_CREATION=false
# Ticket delivery stays off until the itsm-delivery sign-off (docs/runbooks/itsm-delivery.md).
# AISW_ENABLE_ITSM_TICKET_DELIVERY=false
# AISW_ITSM_TARGET=jira                 # jira | servicenow
# AISW_ITSM_BASE_URL=https://<site>     # origin only
# AISW_ITSM_USERNAME=<service account>
# AISW_ITSM_TOKEN=                      (from the secret provider)
# AISW_ITSM_JIRA_PROJECT_KEY=AISW
# AISW_ITSM_JIRA_ISSUE_TYPE=Task
# AISW_ITSM_SERVICENOW_TABLE=incident
# AISW_ITSM_TIMEOUT_SECONDS=10
AISW_LOG_REDACTION_ENABLED=true
# AI stays off unless ALL of these are set and reviewed (see docs/runbooks/ai-enablement.md).
# AISW_MODEL_ID=<approved model name>
# AISW_MODEL_LICENSE=<SPDX id of the reviewed weights licence>
# AISW_MODEL_ENDPOINT=http://127.0.0.1:11434   # loopback only
# AISW_AI_NARRATIVE_ENABLED=true
# AISW_AI_ARCHITECTURE_ENABLED=true
# AISW_MODEL_PROVIDER=ollama                   # ollama (local, default) | astra (remote, ADR-020)

# Astra / Azure OpenAI Responses API (only with AISW_MODEL_PROVIDER=astra; see docs/runbooks/ai-enablement.md).
# With Astra, AISW_MODEL_ID is the deployment name and AISW_MODEL_LICENSE is not used.
# AISW_ASTRA_ENDPOINT=https://<resource>.openai.azure.com   # https origin on an Azure OpenAI host only
# AISW_ASTRA_API_VERSION=2025-04-01-preview
# AISW_ASTRA_API_KEY=                          # from the secret provider; never commit a value
# AISW_ASTRA_DATA_APPROVAL_REF=<ticket/decision id approving redacted findings leaving the host>
# AISW_ASTRA_MAX_OUTPUT_TOKENS=2048
# AISW_ASTRA_VALIDATION_DEPLOYMENT=gpt-5.4     # reviewer deployment (ADR-021); default: AISW_MODEL_ID
# Agent validation pass (ADR-021): runs only when AI is enabled and the run uses ai_assist.
# AISW_AI_VALIDATION_ENABLED=true
# AISW_AI_VALIDATION_BATCH_SIZE=12
# AISW_AI_VALIDATION_MAX_ITEMS_PER_AGENT=60
# AISW_AI_VALIDATION_CONCURRENCY=4
# AISW_AI_VALIDATION_TRIGGER_VERSION=1.0.0     # backend/aisw/llm/policy/triggers-<version>.yaml
# Model-call routing (ADR-023).
# AISW_ASTRA_FALLBACK_DEPLOYMENTS=gpt-5.4      # comma-separated, tried in order on transient failure
# AISW_ASTRA_FAILOVER_COOLDOWN_SECONDS=60      # a failed deployment is skipped this long
# AISW_AI_RUN_TOKEN_BUDGET=200000              # live tokens one run may spend; 0 = no limit
# AISW_ASTRA_PROXY=http://proxy.example:3128 # explicit CONNECT proxy for Astra only (ADR-025)
# AISW_AI_VERIFICATION_QUESTIONS_ENABLED=true  # Agent 4 owner questions (ADR-024)
# AISW_AI_EXECUTIVE_SUMMARY_ENABLED=true       # Agent 8 executive summary (ADR-024)
# AISW_AI_REPLAY_MODE=off                      # off | record | replay (dev/test only)
# AISW_AI_REPLAY_DIR=                          # where recordings live; replay never reaches a model
