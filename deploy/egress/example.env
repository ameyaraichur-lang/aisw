# Example only: names and documentation addresses, no real hosts or secrets. Used to render the
# committed *.example rule files (tests fail if they drift from the renderer).
AISW_ENV=prod
AISW_DATABASE_URL=postgresql+psycopg://aisw_app@db.aisw.example:5432/aisw
AISW_WORKER_DATABASE_URL=postgresql+psycopg://aisw_worker@db.aisw.example:5432/aisw
AISW_OIDC_ISSUER=https://idp.example.com/realms/security
AISW_OIDC_CLIENT_ID=aisw-console
AISW_OIDC_REDIRECT_URI=https://console.aisw.example/api/v1/auth/callback
AISW_SESSION_SECRET=placeholder-not-a-secret-placeholder-xx
AISW_SIGNING_BACKEND=transit
AISW_KMS_ADDR=https://kms.aisw.example:8200
AISW_KMS_KEY=aisw-manifests
AISW_KMS_TOKEN_FILE=/run/secrets/kms-app-token
AISW_EGRESS_DNS_SERVERS=192.0.2.53
AISW_EGRESS_SCAN_CIDRS=198.51.100.0/24,2001:db8:51::/48
AISW_EGRESS_SCAN_PORTS=443
