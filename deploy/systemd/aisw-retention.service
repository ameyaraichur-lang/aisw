# Scheduled retention check (ADR-019), started daily by aisw-retention.timer. Records a dry-run
# plan per tenant; moves evidence to quarantine only with AISW_RETENTION_AUTO_EXECUTE=true.
[Unit]
Description=AISW scheduled retention check
Documentation=file:///opt/aisw/deploy/README.md
After=network-online.target postgresql.service aisw-bootstrap.service
Wants=network-online.target
Requires=aisw-bootstrap.service

[Service]
Type=oneshot
User=aisw
Group=aisw
WorkingDirectory=/opt/aisw/backend
EnvironmentFile=/etc/aisw/aisw.env
LoadCredential=aisw_database_url:/etc/aisw/secrets/aisw_database_url
LoadCredential=aisw_session_secret:/etc/aisw/secrets/aisw_session_secret
LoadCredential=kms_app_token:/etc/aisw/secrets/kms_app_token
Environment=AISW_KMS_TOKEN_FILE=%d/kms_app_token
ExecStart=/opt/aisw/backend/.venv/bin/python -m aisw.evidence.retention_schedule
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/aisw/evidence
