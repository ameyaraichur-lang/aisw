# AISW worker (native install, ADR-029). Egress for this user is filtered by deploy/egress rules.
[Unit]
Description=AISW assessment worker
Documentation=file:///opt/aisw/deploy/README.md
After=network-online.target postgresql.service aisw-bootstrap.service aisw-opa.service
Wants=network-online.target
Requires=aisw-bootstrap.service
Wants=aisw-opa.service

[Service]
Type=exec
User=aisw
Group=aisw
WorkingDirectory=/opt/aisw/backend
EnvironmentFile=/etc/aisw/aisw.env
LoadCredential=aisw_worker_database_url:/etc/aisw/secrets/aisw_worker_database_url
LoadCredential=kms_app_token:/etc/aisw/secrets/kms_app_token
Environment=AISW_KMS_TOKEN_FILE=%d/kms_app_token
Environment=AISW_WORKER_HEARTBEAT_FILE=/run/aisw-worker/heartbeat
RuntimeDirectory=aisw-worker
RuntimeDirectoryMode=0700
ExecStartPre=/opt/aisw/backend/.venv/bin/python -m aisw.doctor --role worker
ExecStart=/opt/aisw/backend/.venv/bin/python -m aisw.orchestrator
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/aisw/evidence

[Install]
WantedBy=multi-user.target
