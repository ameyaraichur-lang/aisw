# AISW egress allow-list: role=worker, service user 'aisw'. Generated by
# tools/egress_check.py from settings (ADR-028); regenerate, do not hand-edit.
# Only the service user's traffic is filtered; everything else on the host is untouched.
# Load with: ip6tables-restore --noflush <file>
*filter
:AISW_EGRESS - [0:0]
-F AISW_EGRESS
-A OUTPUT -m owner --uid-owner aisw -j AISW_EGRESS
-A AISW_EGRESS -o lo -j ACCEPT
-A AISW_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A AISW_EGRESS -d 2001:db8:51::/48 -p tcp -m multiport --dports 443 -m comment --comment "scan-zone" -j ACCEPT
-A AISW_EGRESS -j LOG --log-prefix "aisw-egress-deny "
-A AISW_EGRESS -j DROP
COMMIT
