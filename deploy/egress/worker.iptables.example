# AISW egress allow-list: role=worker, service user 'aisw'. Generated by
# tools/egress_check.py from settings (ADR-028); regenerate, do not hand-edit.
# Only the service user's traffic is filtered; everything else on the host is untouched.
# Load with: iptables-restore --noflush <file>
*filter
:AISW_EGRESS - [0:0]
-F AISW_EGRESS
-A OUTPUT -m owner --uid-owner aisw -j AISW_EGRESS
-A AISW_EGRESS -o lo -j ACCEPT
-A AISW_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A AISW_EGRESS -d 192.0.2.53/32 -p udp -m multiport --dports 53 -m comment --comment "dns" -j ACCEPT
-A AISW_EGRESS -d 192.0.2.53/32 -p tcp -m multiport --dports 53 -m comment --comment "dns" -j ACCEPT
-A AISW_EGRESS -d 192.0.2.10/32 -p tcp -m multiport --dports 5432 -m comment --comment "database" -j ACCEPT
-A AISW_EGRESS -d 192.0.2.30/32 -p tcp -m multiport --dports 8200 -m comment --comment "kms" -j ACCEPT
-A AISW_EGRESS -d 198.51.100.0/24 -p tcp -m multiport --dports 443 -m comment --comment "scan-zone" -j ACCEPT
-A AISW_EGRESS -j LOG --log-prefix "aisw-egress-deny "
-A AISW_EGRESS -j DROP
COMMIT
