# Non-secret settings for the compose deployment. Secrets live in ./secrets/ (see make-secrets.sh).
AISW_ENV=prod
AISW_DEPLOYMENT_MODE=customer_hosted
AISW_EVIDENCE_DIR=/var/lib/aisw/evidence
# Sign-in (ADR-026): register https://<console>/api/v1/auth/callback at your IdP.
AISW_OIDC_ISSUER=https://idp.example.com/realms/security
AISW_OIDC_CLIENT_ID=aisw-console
AISW_OIDC_REDIRECT_URI=https://console.example.com/api/v1/auth/callback
AISW_OIDC_ROLE_MAP={"sec-admins":"project_admin","sec-operators":"assessment_operator","sec-approvers":"approver","sec-readers":"report_reader","sec-audit":"auditor"}
# Signing custody (ADR-027)
AISW_SIGNING_BACKEND=transit
AISW_KMS_ADDR=https://kms.example.com:8200
AISW_KMS_KEY=aisw-manifests
AISW_KMS_TOKEN_FILE=/run/secrets/kms_app_token
# Policy engine (ADR-031): OPA on the internal policy network
AISW_POLICY_ENGINE=opa
AISW_OPA_URL=http://opa:8181
# Egress (ADR-028)
AISW_EGRESS_SCAN_CIDRS=10.20.0.0/16
AISW_EGRESS_DNS_SERVERS=10.0.0.2
# The web container proxies to the API over the internal app network.
AISW_API_TRUSTED_PROXIES=*
AISW_AI_ENABLED=false
