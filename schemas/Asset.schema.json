{
  "$defs": {
    "Confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Confidence",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "asset_type": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Asset Type",
      "type": "string"
    },
    "criticality": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Criticality"
    },
    "criticality_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Criticality Source"
    },
    "environment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "match_confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "native_ids": {
      "additionalProperties": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 2048,
        "minLength": 1
      },
      "title": "Native Ids",
      "type": "object"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "owner_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Source"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "technology": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Technology"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "tenant_id",
    "project_id",
    "asset_type",
    "native_ids",
    "first_seen",
    "last_seen",
    "match_confidence"
  ],
  "title": "Asset",
  "type": "object"
}
