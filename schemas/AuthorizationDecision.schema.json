{
  "$defs": {
    "Decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "APPROVAL_REQUIRED"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "manifest_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Hash"
    },
    "reason_codes": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "decision",
    "reason_codes"
  ],
  "title": "AuthorizationDecision",
  "type": "object"
}
