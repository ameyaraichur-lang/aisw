# Names only. Never commit real values; secrets come from the vault by reference.
AISW_ENV=dev
AISW_ASSESSMENT_MODE=read_only
AISW_ALLOW_PRODUCTION_REMEDIATION=false
AISW_REQUIRE_SCOPE_MANIFEST=true
AISW_REQUIRE_APPROVAL_FOR_ACTIVE_SCANS=true
AISW_DEV_AUTH_STUB=true
AISW_AI_ENABLED=false
AISW_MODEL_TIMEOUT_SECONDS=60
AISW_EVIDENCE_RETENTION_DAYS=365
AISW_MAX_ASSESSMENT_CONCURRENCY=2
AISW_ENABLE_ITSM_TICKET_CREATION=false
AISW_LOG_REDACTION_ENABLED=true
# AI stays off unless ALL of these are set and reviewed (see docs/runbooks/ai-enablement.md).
# AISW_MODEL_ID=<approved model name>
# AISW_MODEL_LICENSE=<SPDX id of the reviewed weights licence>
# AISW_MODEL_ENDPOINT=http://127.0.0.1:11434   # loopback only
# AISW_AI_NARRATIVE_ENABLED=true
# AISW_AI_ARCHITECTURE_ENABLED=true
# AISW_MODEL_PROVIDER=ollama                   # ollama (local, default) | astra (remote, ADR-020)

# Astra / Azure OpenAI Responses API (only with AISW_MODEL_PROVIDER=astra; see docs/runbooks/ai-enablement.md).
# With Astra, AISW_MODEL_ID is the deployment name and AISW_MODEL_LICENSE is not used.
# AISW_ASTRA_ENDPOINT=https://<resource>.openai.azure.com   # https origin on an Azure OpenAI host only
# AISW_ASTRA_API_VERSION=2025-04-01-preview
# AISW_ASTRA_API_KEY=                          # from the secret provider; never commit a value
# AISW_ASTRA_DATA_APPROVAL_REF=<ticket/decision id approving redacted findings leaving the host>
# AISW_ASTRA_MAX_OUTPUT_TOKENS=2048
# AISW_ASTRA_VALIDATION_DEPLOYMENT=gpt-5.4     # reviewer deployment (ADR-021); default: AISW_MODEL_ID
# Agent validation pass (ADR-021): runs only when AI is enabled and the run uses ai_assist.
# AISW_AI_VALIDATION_ENABLED=true
# AISW_AI_VALIDATION_BATCH_SIZE=12
# AISW_AI_VALIDATION_MAX_ITEMS_PER_AGENT=60
# AISW_AI_VALIDATION_CONCURRENCY=4
