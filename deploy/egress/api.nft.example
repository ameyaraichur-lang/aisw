#!/usr/sbin/nft -f
# AISW egress allow-list: role=api, service user 'aisw'. Generated by
# tools/egress_check.py from settings (ADR-028); regenerate, do not hand-edit.
# Only the service user's traffic is filtered; everything else on the host is untouched.
table inet aisw_egress
delete table inet aisw_egress
table inet aisw_egress {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid != "aisw" accept
    oif "lo" accept
    ct state established,related accept
    ip daddr 192.0.2.53/32 udp dport { 53 } accept  # dns
    ip daddr 192.0.2.53/32 tcp dport { 53 } accept  # dns
    ip daddr 192.0.2.10/32 tcp dport { 5432 } accept  # database
    ip daddr 192.0.2.20/32 tcp dport { 443 } accept  # idp
    ip daddr 192.0.2.30/32 tcp dport { 8200 } accept  # kms
    counter log prefix "aisw-egress-deny " drop
  }
}
